{
  "name": "md-to-docx",
  "version": "1.0.0",
  "description": "Obsidian plugin that exports Markdown notes to .docx format",
  "main": "md-to-docx/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dist": "npm run build && node scripts/copy-to-vault.mjs"
  },
  "keywords": [],
  "author": "firedisposal <3295829485@qq.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  }
}
